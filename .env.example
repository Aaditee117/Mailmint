# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit it, never paste its contents into a chat.
#
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your Google account
# password. Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
# Paste it without spaces.

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
